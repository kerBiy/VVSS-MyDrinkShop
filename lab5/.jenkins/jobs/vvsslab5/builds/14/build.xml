    <script>pipeline {
    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
        timeout(time: 20, unit: &apos;MINUTES&apos;)
    }

    environment {
        MAVEN_OPTS = &apos;-Djavax.net.ssl.trustStoreType=WINDOWS-ROOT&apos;
        PROJECT_DIR = &apos;D:\\VVSS lab 5\\parabank&apos;
        CARGO_GOAL = &apos;org.codehaus.cargo:cargo-maven3-plugin:1.10.27&apos;
        SERENITY_GOAL = &apos;net.serenity-bdd.maven.plugins:serenity-maven-plugin:3.9.0&apos;
    }

    stages {
        stage(&apos;Environment&apos;) {
            steps {
                bat &apos;java -version&apos;
                bat &apos;mvn -version&apos;
            }
        }

        stage(&apos;Start ParaBank&apos;) {
            steps {
                dir(env.PROJECT_DIR) {
                    bat &apos;mvn -DskipTests package &quot;%CARGO_GOAL%:start&quot;&apos;
                }
            }
        }

        stage(&apos;Wait For ParaBank&apos;) {
            steps {
                bat &apos;powershell -NoProfile -Command &quot;Start-Sleep -Seconds 10&quot;&apos;
            }
        }

        stage(&apos;Run Tests&apos;) {
            steps {
                dir(env.PROJECT_DIR) {
                    bat &apos;mvn test &quot;-Dtest=LoginBlackBoxTest,ScenarioBasedTest&quot;&apos;
                    bat &apos;mvn &quot;%SERENITY_GOAL%:aggregate&quot;&apos;
                }
            }
        }
    }

    post {
        always {
            dir(env.PROJECT_DIR) {
                bat returnStatus: true, script: &apos;mvn &quot;%CARGO_GOAL%:stop&quot;&apos;
            }
            junit allowEmptyResults: true, testResults: &apos;D:/VVSS lab 5/parabank/target/surefire-reports/*.xml,D:/VVSS lab 5/parabank/target/failsafe-reports/*.xml&apos;
            archiveArtifacts allowEmptyArchive: true, artifacts: &apos;parabank/target/site/serenity/**,parabank/target/surefire-reports/**,parabank/target/failsafe-reports/**&apos;
        }
    }
}
</script>

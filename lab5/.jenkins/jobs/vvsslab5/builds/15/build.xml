        disableConcurrentBuilds()
        timeout(time: 20, unit: &apos;MINUTES&apos;)
    }

    environment {
        PROJECT_DIR = &apos;D:\\VVSS lab 5\\parabank&apos;
        PARABANK_URL = &apos;http://localhost:8080/parabank/index.htm&apos;
        MAVEN_OPTS = &apos;-Djavax.net.ssl.trustStoreType=WINDOWS-ROOT&apos;
        CARGO_GOAL = &apos;org.codehaus.cargo:cargo-maven3-plugin:1.10.27&apos;
        SERENITY_GOAL = &apos;net.serenity-bdd.maven.plugins:serenity-maven-plugin:3.9.0&apos;
    }

    stages {
        stage(&apos;Environment&apos;) {
            steps {
                bat &apos;java -version&apos;
                bat &apos;mvn -version&apos;
            }
        }

        stage(&apos;Build ParaBank&apos;) {
            steps {
                dir(env.PROJECT_DIR) {
                    bat &apos;mvn -DskipTests clean package&apos;
                }
            }
        }

        stage(&apos;Start ParaBank&apos;) {
            steps {
                dir(env.PROJECT_DIR) {
                    powershell &apos;&apos;&apos;
                        $ErrorActionPreference = &apos;Stop&apos;
                        $log = Join-Path $env:PROJECT_DIR &apos;target\\parabank-cargo.log&apos;
                        $err = Join-Path $env:PROJECT_DIR &apos;target\\parabank-cargo.err&apos;
                        Remove-Item $log, $err -Force -ErrorAction SilentlyContinue

                        $mvn = (Get-Command mvn.cmd -ErrorAction SilentlyContinue).Source
                        if (-not $mvn) {
                            $mvn = (Get-Command mvn -ErrorAction Stop).Source
                        }

                        Start-Process `
                            -FilePath $mvn `
                            -ArgumentList @(&apos;-DskipTests&apos;, &quot;${env:CARGO_GOAL}:run&quot;) `
                            -WorkingDirectory $env:PROJECT_DIR `
                            -RedirectStandardOutput $log `
                            -RedirectStandardError $err `
                            -WindowStyle Hidden
                    &apos;&apos;&apos;
                }
            }
        }

        stage(&apos;Wait For ParaBank&apos;) {
            steps {
                powershell &apos;&apos;&apos;
                    $ErrorActionPreference = &apos;Stop&apos;
                    $ready = $false

                    for ($i = 1; $i -le 30; $i++) {
                        try {
                            $html = (Invoke-WebRequest -Uri $env:PARABANK_URL -UseBasicParsing -TimeoutSec 5).Content
                            if ($html -match &apos;name=&quot;username&quot;&apos;) {
                                $ready = $true
                                break
                            }
                        } catch {
                            Write-Host &quot;ParaBank not ready yet, attempt $i&quot;
                        }

                        Start-Sleep -Seconds 3
                    }

                    if (-not $ready) {
                        Get-Content &quot;$env:PROJECT_DIR\\target\\parabank-cargo.log&quot; -Tail 120 -ErrorAction SilentlyContinue
                        throw &quot;ParaBank did not become ready with the login form.&quot;
                    }
                &apos;&apos;&apos;
            }
        }

        stage(&apos;Run Tests&apos;) {
            steps {
                dir(env.PROJECT_DIR) {
                    bat &apos;mvn test &quot;-Dtest=LoginBlackBoxTest,ScenarioBasedTest&quot;&apos;
                    bat &apos;mvn &quot;%SERENITY_GOAL%:aggregate&quot;&apos;
                }
            }
        }
    }

    post {
        always {
            dir(env.PROJECT_DIR) {
                bat returnStatus: true, script: &apos;mvn &quot;%CARGO_GOAL%:stop&quot;&apos;
            }

            powershell &apos;&apos;&apos;
                $ports = @(8080, 8205, 9001)
                foreach ($port in $ports) {
                    Get-NetTCPConnection -LocalPort $port -ErrorAction SilentlyContinue |
                        Select-Object -ExpandProperty OwningProcess -Unique |
                        ForEach-Object {
                            Stop-Process -Id $_ -Force -ErrorAction SilentlyContinue
                        }
                }
            &apos;&apos;&apos;

            dir(env.PROJECT_DIR) {
                junit allowEmptyResults: true, testResults: &apos;target/surefire-reports/*.xml,target/failsafe-reports/*.xml&apos;
                archiveArtifacts allowEmptyArchive: true, artifacts: &apos;target/site/serenity/**,target/surefire-reports/**,target/failsafe-reports/**&apos;
            }
        }
    }
}

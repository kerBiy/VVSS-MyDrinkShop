                                    Invoke-WebRequest -Uri &quot;$env:PARABANK_URL/index.htm&quot; -UseBasicParsing | Out-Null
                                    Start-Sleep -Seconds 5
                                    $ok = $true
                                    break
                                } catch {
                                    Start-Sleep -Seconds 3
                                }
                            }
                            if (-not $ok) {
                                throw &quot;ParaBank did not become ready in time.&quot;
                            }
                        &apos;&apos;&apos;
                    }
                }
            }
        }

        stage(&apos;Run Serenity Tests&apos;) {
            steps {
                dir(&apos;parabank&apos;) {
                    script {
                        if (isUnix()) {
                            sh &apos;mvn test -Dtest=LoginBlackBoxTest,ScenarioBasedTest&apos;
                            sh &apos;mvn &quot;$SERENITY_GOAL:aggregate&quot;&apos;
                        } else {
                            bat &apos;mvn test &quot;-Dtest=LoginBlackBoxTest,ScenarioBasedTest&quot;&apos;
                            bat &apos;mvn &quot;%SERENITY_GOAL%:aggregate&quot;&apos;
                        }
                    }
                }
            }
        }
    }

    post {
        always {
            dir(&apos;parabank&apos;) {
                script {
                    if (isUnix()) {
                        sh &apos;mvn &quot;$CARGO_GOAL:stop&quot; || true&apos;
                    } else {
                        bat &apos;mvn &quot;%CARGO_GOAL%:stop&quot; || exit /b 0&apos;
                    }
                }
            }
            junit allowEmptyResults: true, testResults: &apos;parabank/target/surefire-reports/*.xml,parabank/target/failsafe-reports/*.xml&apos;
            archiveArtifacts allowEmptyArchive: true, artifacts: &apos;parabank/target/site/serenity/**,parabank/target/surefire-reports/**,parabank/target/failsafe-reports/**&apos;
        }
    }
}
